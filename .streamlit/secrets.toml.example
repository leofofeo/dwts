# Streamlit Secrets Configuration
# Copy this file to .streamlit/secrets.toml and fill in your values

# Database URL - Use Turso (recommended) or any other SQL database
# For Turso: Get your database URL from https://turso.tech
# Format: libsql://your-database.turso.io?authToken=your-token
DATABASE_URL = "libsql://your-database-name.turso.io?authToken=your-auth-token"

# Note: When deploying to Streamlit Cloud, add these secrets in the app settings
# instead of using this file
